@model SubmitStoryViewModel
@{
    ViewData["Title"] = "Submit a Story";
}

<div class="max-w-3xl mx-auto px-6 py-12">
    <h1 class="font-['Playfair_Display'] text-4xl text-center mb-4">Share Your Story</h1>
    <div class="text-center mb-8">— ✦ —</div>

    <p class="text-center text-gray-600 mb-8">
        Do you have a historical story, family memory, or local legend about Cebu?<br />
        Submit it below. Our admin will review and publish it if approved.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
            @TempData["Success"]
        </div>
    }

    <!-- ADDED enctype="multipart/form-data" for file upload -->
    <form method="post" enctype="multipart/form-data" class="space-y-5">
        @Html.AntiForgeryToken()

        <!-- FIXED: Authentication check - shows name field only for NON-logged in users -->
        @if (User.Identity?.IsAuthenticated != true)
        {
            <div>
                <label class="block text-stone text-xs tracking-widest uppercase mb-1">Your Name *</label>
                <input asp-for="SubmitterName" class="w-full bg-white border border-gold/30 px-4 py-2.5" required />
                <p class="text-xs text-gray-400 mt-1">You'll be credited as the submitter</p>
            </div>
        }

        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1">Story Title *</label>
            <input asp-for="Title" class="w-full bg-white border border-gold/30 px-4 py-2.5" required />
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-stone text-xs tracking-widest uppercase mb-1">Author/Credited Name</label>
                <input asp-for="Author" class="w-full bg-white border border-gold/30 px-4 py-2.5" />
                <p class="text-xs text-gray-400 mt-1">Leave blank to use your name</p>
            </div>
            <div>
                <label class="block text-stone text-xs tracking-widest uppercase mb-1">Era</label>
                <select asp-for="Era" class="w-full bg-white border border-gold/30 px-4 py-2.5">
                    <option value="">Select era...</option>
                    <option>Pre-Colonial</option>
                    <option>Spanish Colonial</option>
                    <option>Revolution & American Period</option>
                    <option>World War II</option>
                    <option>Modern</option>
                </select>
            </div>
        </div>

        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1">Category</label>
            <select asp-for="Category" class="w-full bg-white border border-gold/30 px-4 py-2.5">
                <option value="">Select category...</option>
                <option>War & Resistance</option>
                <option>Religion & Culture</option>
                <option>Culture & Daily Life</option>
                <option>People & Personalities</option>
                <option>Architecture & Heritage</option>
            </select>
        </div>

        <!-- FILE UPLOAD BUTTON - NEW! -->
        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1">📷 Upload Image (from your computer)</label>
            <input type="file" name="ImageFile" accept="image/*" class="w-full bg-white border border-gold/30 px-4 py-2.5" />
            <p class="text-xs text-gray-400 mt-1">Click "Browse" to select an image from your computer</p>
        </div>

        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1">🔗 Image URL (or fallback)</label>
            <input asp-for="CoverImage" type="url" class="w-full bg-white border border-gold/30 px-4 py-2.5" placeholder="https://..." />
            <p class="text-xs text-gray-400 mt-1">Only needed if you don't upload a file</p>
        </div>

        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1">Short Excerpt/Summary *</label>
            <textarea asp-for="Excerpt" rows="2" class="w-full bg-white border border-gold/30 px-4 py-2.5" required></textarea>
        </div>

        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1">Full Story *</label>
            <textarea asp-for="Body" rows="12" class="w-full bg-white border border-gold/30 px-4 py-2.5 font-mono text-sm" required></textarea>
            <p class="text-xs text-gray-400 mt-1">Use blank lines between paragraphs.</p>
        </div>

        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1">Tags (comma separated)</label>
            <input asp-for="Tags" class="w-full bg-white border border-gold/30 px-4 py-2.5" placeholder="e.g., fort, spanish, cebu" />
        </div>

        <div class="flex gap-4 pt-4">
            <button type="submit" class="bg-[#8b3a18] text-white px-8 py-3 text-sm tracking-widest uppercase hover:bg-[#b0501f] transition-colors">
                📤 Submit for Review
            </button>
            <a href="/" class="text-stone text-sm tracking-widest uppercase self-center hover:text-ink">Cancel</a>
        </div>
    </form>
</div>