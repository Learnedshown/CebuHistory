@model PhotoFormViewModel
@{
    ViewData["Title"] = "Edit Photo";
}

<div class="max-w-2xl mx-auto px-6 py-12">
    <h1 class="font-display text-3xl font-bold text-ink mb-8">Edit Photo</h1>
    <form asp-action="EditPhoto" asp-controller="Admin" asp-route-id="@Model.Id" method="post" class="space-y-5">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-red-700 text-sm bg-red-50 border border-red-200 p-3"></div>
        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Title *</label>
            <input asp-for="Title" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna" />
        </div>
        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Image URL *</label>
            <input asp-for="ImageUrl" type="url" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna" />
        </div>
        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Description</label>
            <textarea asp-for="Description" rows="3" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna"></textarea>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Era</label>
                <input asp-for="Era" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna" />
            </div>
            <div>
                <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Year</label>
                <input asp-for="Year" type="number" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna" />
            </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Location</label>
                <input asp-for="Location" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna" />
            </div>
            <div>
                <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Source</label>
                <input asp-for="Source" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna" />
            </div>
        </div>
        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Photographer</label>
            <input asp-for="Photographer" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna" />
        </div>
        <div class="flex items-center gap-2">
            <input asp-for="IsPublicDomain" type="checkbox" class="accent-sienna" />
            <label asp-for="IsPublicDomain" class="text-stone text-sm" style="font-family:'Cormorant Garamond',serif;">Public domain / open access</label>
        </div>
        <div class="flex gap-4 pt-2">
            <button type="submit" class="bg-gold text-ink px-8 py-3 text-sm tracking-widest uppercase hover:bg-gold-light transition-colors" style="font-family:'Cormorant Garamond',serif;">Save Changes</button>
            <a href="/Admin/Photos" class="text-stone text-sm tracking-widest uppercase self-center hover:text-ink" style="font-family:'Cormorant Garamond',serif;">Cancel</a>
        </div>
    </form>
</div>