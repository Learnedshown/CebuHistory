@model StoryFormViewModel
@{
    ViewData["Title"] = "Edit Story";
}

<div class="max-w-3xl mx-auto px-6 py-12">
    <h1 class="font-display text-3xl font-bold text-ink mb-8">Edit Story</h1>
    <form asp-action="EditStory" asp-controller="Admin" asp-route-id="@Model.Id" method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-red-700 text-sm bg-red-50 border border-red-200 p-3"></div>
        <input asp-for="Id" type="hidden" />

        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Title *</label>
            <input asp-for="Title" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna" />
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Era</label>
                <input asp-for="Era" list="era-list" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna" />
                <datalist id="era-list">
                    <option value="Pre-Colonial / Spanish Contact" />
                    <option value="Spanish Colonial" />
                    <option value="Revolution & American Period" />
                    <option value="World War II" />
                    <option value="Modern" />
                </datalist>
            </div>
            <div>
                <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Category</label>
                <input asp-for="Category" list="cat-list" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna" />
                <datalist id="cat-list">
                    <option value="War & Resistance" />
                    <option value="Religion & Culture" />
                    <option value="Religion & Conversion" />
                    <option value="Culture & Daily Life" />
                    <option value="Politics & Governance" />
                </datalist>
            </div>
        </div>
        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Author Name</label>
            <input asp-for="Author" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna" />
        </div>
        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Cover Image URL</label>
            <input asp-for="CoverImage" type="url" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna" />
        </div>
        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Excerpt</label>
            <textarea asp-for="Excerpt" rows="2" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna"></textarea>
        </div>
        <div>
            <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Body *</label>
            <textarea asp-for="Body" rows="16" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna font-mono text-sm"></textarea>
        </div>
        <div class="grid grid-cols-3 gap-4">
            <div>
                <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Tags</label>
                <input asp-for="Tags" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna" />
            </div>
            <div>
                <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Reading Time (min)</label>
                <input asp-for="ReadingTime" type="number" min="1" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna" />
            </div>
            <div>
                <label class="block text-stone text-xs tracking-widest uppercase mb-1" style="font-family:'Cormorant Garamond',serif;">Status</label>
                <select asp-for="Status" class="w-full bg-white border border-gold/30 px-4 py-2.5 text-ink focus:outline-none focus:border-sienna">
                    <option value="Published">Published</option>
                    <option value="Draft">Draft</option>
                </select>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <input asp-for="IsFeatured" type="checkbox" class="accent-sienna" />
            <label asp-for="IsFeatured" class="text-stone text-sm" style="font-family:'Cormorant Garamond',serif;">Feature on homepage</label>
        </div>
        <div class="flex gap-4 pt-2">
            <button type="submit" class="bg-sienna text-parchment px-8 py-3 text-sm tracking-widest uppercase hover:bg-sienna-light transition-colors" style="font-family:'Cormorant Garamond',serif;">Save Changes</button>
            <a href="/Admin/Stories" class="text-stone text-sm tracking-widest uppercase self-center hover:text-ink" style="font-family:'Cormorant Garamond',serif;">Cancel</a>
        </div>
    </form>
</div>